# Google Gemini API key — powers the AI Mentor, FinScore explanations and the
# Future Self Letter. Get a free key at https://aistudio.google.com/apikey
#
# Without this key the app still works: every AI surface silently falls back to
# a deterministic, rule-based mentor that reads the same user data.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
